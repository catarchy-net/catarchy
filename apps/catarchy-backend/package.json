{
  "name": "catarchy-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "dev:cf": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "bun --version && bun run build:types && bun build src/index.ts --outdir ./dist --target bun --external cloudflare:workers",
    "build:types": "tsc -b . && tsc-alias",
    "start": "bun run dist/index.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate && bun run src/infra/db/fix-migration.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute catarchy-db --local --file src/infra/db/seed.sql",
    "db:seed:prod": "wrangler d1 execute catarchy-db --remote --file src/infra/db/seed.sql",
    "db:reset": "bun run scripts/db-reset.ts",
    "db:update-config": "bun run scripts/db-update-config.ts",
    "db:delete-user": "bun run scripts/db-delete-user.ts",
    "db:seed-test-users": "bun run scripts/db-seed-test-users.ts",
    "db:delete-test-users": "bun run scripts/db-delete-test-users.ts",
    "localflare": "localflare",
    "test": "bun test src"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.66",
    "@ai-sdk/anthropic": "4.0.79",
    "@catarchy/shared": "workspace:*",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/eden": "1.4.9",
    "@elysiajs/jwt": "1.4.2",
    "@elysiajs/openapi": "1.4.16",
    "ai": "7.0.140",
    "ai-gateway-provider": "4.0.1",
    "drizzle-orm": "0.45.4",
    "drizzle-typebox": "0.3.3",
    "elysia": "1.4.30",
    "ms": "2.1.3",
    "uuidv7": "1.2.1",
    "viem": "2.57.5",
    "zod": "4.6.7",
    "@ai-sdk/gateway": "4.0.113"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/bun": "1.4.3",
    "@types/ms": "2.1.0",
    "drizzle-kit": "0.31.11",
    "localflare": "0.5.0",
    "tsc-alias": "1.9.7",
    "wrangler": "4.150.0"
  },
  "type": "module"
}
